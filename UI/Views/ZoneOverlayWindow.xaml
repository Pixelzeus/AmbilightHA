<Window x:Class="AmbilightHA.UI.Views.ZoneOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambilight Zone Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">

    <Canvas x:Name="OverlayCanvas">
        <!-- Les rectangles de zones seront générés dynamiquement par le code-behind -->
    </Canvas>
</Window>
