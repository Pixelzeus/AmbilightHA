<Window x:Class="AmbilightHA.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AmbilightHA.UI.ViewModels"
        Title="Ambilight Gaming Home Assistant - DXGI High Performance" 
        Height="820" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Picker d'Écran -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="🖥️ Écran:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableDisplays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="Name" Width="240" VerticalAlignment="Center" ToolTip="Sélectionner l'écran à capturer (Multi-Écrans)"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
                    <Button Content="▶ DÉMARRER" Command="{Binding StartCommand}" Background="{StaticResource SuccessColor}" Foreground="White" Padding="16,8" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="⏹ ARRÊTER" Command="{Binding StopCommand}" Background="{StaticResource DangerColor}" Foreground="White" Padding="16,8" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚡ AMBILIGHT HOME ASSISTANT" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                    <TextBlock Text="Capture d'écran DXGI Temps Réel &amp; Controlleur de Capteurs / Ampoules" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabbed Container -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <ContentPresenter Content="{TemplateBinding Content}" Margin="12,6"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#A0A0B0"/>
                    <Setter Property="Background" Value="#1A1A24"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="8,4">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource BgCard}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1 : Ampoules & Capteurs -->
            <TabItem Header="💡 Ampoules &amp; Capteurs (Mapping Zones)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="160" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="➕ Ajouter une ampoule" Command="{Binding AddEntityCommand}" Background="{StaticResource SuccessColor}" Foreground="White" Padding="10,6" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand" ToolTip="Ajouter une seule ampoule au mapping"/>
                                    <Button Content="➕➕ Lot de 3 (G / C / D)" Command="{Binding AddMultipleEntitiesCommand}" Background="#00A8FF" Foreground="White" Padding="10,6" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand" ToolTip="Ajouter rapidement un lot de 3 ampoules (Gauche, Centre, Droite)"/>
                                    <Button Content="👁️ Overlay Zones" Command="{Binding ToggleOverlayCommand}" Background="#2D2B55" Foreground="Cyan" Padding="10,6" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                                <TextBlock Text="💡 Configuration des Équipements Lumineux &amp; Zones" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ZoneMappings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A24" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#2A2A38">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="40" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Aperçu Couleur Réelle -->
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding PreviewColor}" />
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Type d'Équipement -->
                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                        <TextBlock Text="Type d'équipement:" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                                                        <ComboBox ItemsSource="{Binding AvailableDeviceTypes}" SelectedItem="{Binding SelectedDeviceType}" DisplayMemberPath="Name" Background="#101018" Foreground="White" Padding="6"/>
                                                    </StackPanel>

                                                    <!-- Champ Cible (Entité HA ou IP WLED) -->
                                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding TargetLabel}" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                                                        <Grid>
                                                            <TextBox x:Name="TxtEntity" Text="{Binding EntityId, UpdateSourceTrigger=PropertyChanged}" Background="#101018" Foreground="#00FFCC" Padding="6" BorderThickness="1" BorderBrush="#333"/>
                                                            <TextBox x:Name="TxtWledIp" Text="{Binding WledIpAddress, UpdateSourceTrigger=PropertyChanged}" Background="#101018" Foreground="#FFCC00" Padding="6" BorderThickness="1" BorderBrush="#333" Visibility="Collapsed"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Liste Déroulante Sélection Zone -->
                                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                                        <TextBlock Text="Zone d'écran associée:" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                                                        <ComboBox ItemsSource="{Binding AvailableZones}" SelectedItem="{Binding SelectedZone}" DisplayMemberPath="Name" Background="#101018" Foreground="White" Padding="6"/>
                                                    </StackPanel>

                                                    <!-- Bouton Supprimer -->
                                                    <Button Grid.Column="4" Content="❌" Command="{Binding DataContext.RemoveEntityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#FF5555" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Cursor="Hand" ToolTip="Retirer cette entité"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsWledUdpMode}" Value="True">
                                                    <Setter TargetName="TxtEntity" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="TxtWledIp" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Console de Logs -->
                    <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <TextBlock Text="📋 Log Console" FontWeight="Bold" FontSize="12" DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="{StaticResource TextSecondary}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Background="#0C0C12" Foreground="#A0F0A0" FontFamily="Consolas" FontSize="11" Padding="8" BorderThickness="0"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2 : Connexion & Réglages Image -->
            <TabItem Header="🎛️ Connexion &amp; Réglages Image">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Carte HA -->
                        <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="🔗 Connexion Home Assistant" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Foreground="{StaticResource AccentColor}"/>

                                <TextBlock Text="URL WebSocket / HTTP Home Assistant:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding HaUrl, UpdateSourceTrigger=PropertyChanged}" Background="#15151C" Foreground="White" Padding="8" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#333"/>

                                <TextBlock Text="Token d'accès longue durée (Long-Lived Access Token):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding HaToken, UpdateSourceTrigger=PropertyChanged}" Background="#15151C" Foreground="White" Padding="8" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#333"/>

                                <!-- Option Restauration éclairage -->
                                <CheckBox IsChecked="{Binding RestoreLightsOnStop}" Content="🔄 Restaurer l'éclairage d'origine à l'arrêt" Foreground="White" FontSize="12" Margin="0,0,0,14" Cursor="Hand" ToolTip="Rétablit automatiquement la couleur, la luminosité et l'état (allumé/éteint) initial des ampoules quand Ambilight s'arrête"/>

                                <Button Content="💾 Sauvegarder la Configuration" Command="{Binding SaveConfigCommand}" Background="{StaticResource AccentColor}" Foreground="White" Padding="10" FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Carte Réglages Image & Performance -->
                        <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🎨 Réglages Couleurs &amp; Écran" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Foreground="{StaticResource AccentColor}"/>

                                <!-- Sélection Écran Cible -->
                                <TextBlock Text="🖥️ Écran à Capturer (Multi-Écrans):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableDisplays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="Name" Background="#15151C" Foreground="White" Padding="8" Margin="0,0,0,10" ToolTip="Choix de l'écran principal ou secondaire pour la capture d'image temps réel DXGI"/>

                                <!-- Mode d'Analyse -->
                                <TextBlock Text="Mode d'Analyse des Couleurs:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableAnalysisModes}" SelectedItem="{Binding SelectedAnalysisMode}" DisplayMemberPath="Name" Background="#15151C" Foreground="White" Padding="8" Margin="0,0,0,10"/>

                                <!-- Rejet des Gris / Pondération Saturation -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Filtrage / Rejet des Gris (Pondération):" FontSize="12"/>
                                    <TextBlock Text="{Binding AccentWeightExponent, StringFormat={}{0:F1}x}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="4.0" Value="{Binding AccentWeightExponent}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,10" ToolTip="Augmenter pour isoler les couleurs vives et ignorer l'asphalte/les décors gris"/>

                                <!-- Saturation -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Saturation Boost:" FontSize="12"/>
                                    <TextBlock Text="{Binding Saturation, StringFormat={}{0:F2}x}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding Saturation}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <!-- Luminosité -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Luminosité Échelle:" FontSize="12"/>
                                    <TextBlock Text="{Binding Brightness, StringFormat={}{0:F2}x}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="0.2" Maximum="2.0" Value="{Binding Brightness}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <!-- Gamma -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Correction Gamma:" FontSize="12"/>
                                    <TextBlock Text="{Binding Gamma, StringFormat={}{0:F2}}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding Gamma}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <!-- Plancher Luminosité Min -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Plancher Luminosité Min (Évite l'extinction complete):" FontSize="12"/>
                                    <TextBlock Text="{Binding MinBrightness, StringFormat={}{0} / 255}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" Value="{Binding MinBrightness}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <!-- Transition HA -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Temps de Transition HA (sec):" FontSize="12"/>
                                    <TextBlock Text="{Binding TransitionSeconds, StringFormat={}{0:F2}s}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="0.05" Maximum="1.0" Value="{Binding TransitionSeconds}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <!-- FPS Cible -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="FPS Cible Capture:" FontSize="12"/>
                                    <TextBlock Text="{Binding TargetFps, StringFormat={}{0} FPS}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="10" Maximum="60" Value="{Binding TargetFps}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <!-- Rate Limit Ampoule -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Max Envois / sec / Ampoule (Rate Limit):" FontSize="12"/>
                                    <TextBlock Text="{Binding RateLimitPerBulb, StringFormat={}{0} req/s}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="20" Value="{Binding RateLimitPerBulb}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
